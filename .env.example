# ---------------------------------------------------------------------------
# Dayflow — environment variables
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings → API).
#
# `.env.local` is git-ignored (see `.gitignore`: `.env*`) and must never be
# committed. `.env.example` is the committed template and never holds secrets.
#
# Only the PUBLIC / publishable keys belong here. The frontend must never see
# the `service_role` key — it bypasses Row Level Security and would expose
# every user's data to the browser.
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Publishable (public) anon key — safe to ship to the browser because RLS
# enforces row ownership. Find it under Project Settings → API.
# Newer projects call this the "publishable key"; older ones call it "anon key".
VITE_SUPABASE_PUBLISHABLE_KEY=
